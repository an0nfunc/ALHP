[Unit]
Description=Go based Archlinux instruction-set enabled repo build manager.
After=network.target

[Service]
User=alhp
Group=alhp
WorkingDirectory=/home/alhp/ALHP.GO
ExecStart=/home/alhp/ALHP.GO/ALHP.go
# deliberately NOT KillMode=mixed: the default control-group signals the whole
# cgroup at the start of the stop job, which reaches the systemd-nspawn
# supervisor, and nspawn then kills the container. Under mixed the supervisor
# only ever gets SIGKILL, its shutdown handler never runs, and build payloads
# silently survive systemctl stop.
TimeoutStopSec=5min
MemoryHigh=30G
CPUQuota=700%
Nice=15
CPUSchedulingPolicy=batch
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=100

[Install]
WantedBy=multi-user.target